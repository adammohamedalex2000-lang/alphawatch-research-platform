# Optional local configuration for the portfolio edition.
# Never commit a real .env file.

APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000

# SEC requests should identify the application and provide a real contact.
SEC_USER_AGENT=AlphaWatchResearch/portfolio your-email@example.com

# Paper-only is a hard boundary in this repository.
PAPER_ONLY=true
